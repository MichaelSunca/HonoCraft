{
  "name": "honocraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages scripts tests --max-warnings=0",
    "check": "pnpm lint && pnpm typecheck",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "env:check": "tsx scripts/env-check.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "start:web": "tsx apps/server/src/main.ts",
    "start:worker": "tsx apps/server/src/worker-main.ts",
    "dev:worker": "tsx watch apps/server/src/worker-main.ts",
    "ops:init": "tsx scripts/ops-init.ts"
  },
  "devDependencies": {
    "@embedded-postgres/linux-x64": "17.10.0-beta.17",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "pg": "^8.23.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0",
    "zod": "^4.6.5"
  }
}
