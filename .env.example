NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
PORT=3000
# Use independent database roles in production; never commit real connection secrets.
DATABASE_URL=postgresql://honocraft_app:replace-me@127.0.0.1:5432/honocraft_dev
MIGRATION_DATABASE_URL=postgresql://honocraft_owner:replace-me@127.0.0.1:5432/honocraft_dev
WORKER_DATABASE_URL=postgresql://honocraft_worker:replace-me@127.0.0.1:5432/honocraft_dev
MAINTENANCE_DATABASE_URL=postgresql://honocraft_maintenance:replace-me@127.0.0.1:5432/honocraft_dev
MAIL_MODE=capture
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=HonoCraft <noreply@example.test>
FILE_STORAGE_ROOT=.local/media
MAIL_PAYLOAD_KEYRING_FILE=.local/secrets/mail.json
DIGEST_KEY_FILE=.local/secrets/digest
CSRF_KEY_FILE=.local/secrets/csrf
CREDENTIAL_EPOCH_FILE=.local/secrets/epoch
TRUSTED_PROXY_CIDRS=
EXAMPLE_NOTES_ENABLED=true
